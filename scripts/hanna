#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
  echo "Hanna: run me from inside the DnD_Bot_Interface repository." >&2
  exit 1
fi
cd "$ROOT"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Hanna: refusing to launch Codex from a dirty working tree." >&2
  echo "Commit, stash, or discard the current changes first." >&2
  git status --short >&2
  exit 1
fi

BRANCH="$(git branch --show-current)"
if [[ -z "$BRANCH" ]]; then
  echo "Hanna: refusing to run from a detached HEAD." >&2
  exit 1
fi

echo "Hanna: syncing $BRANCH..."
git pull --ff-only
START_HEAD="$(git rev-parse HEAD)"

if [[ $# -gt 0 ]]; then
  MISSION="$1"
else
  CURRENT="$(tr -d '\r\n' < prompts/CURRENT)"
  MISSION="prompts/$CURRENT"
fi

if [[ ! -f "$MISSION" ]]; then
  echo "Hanna: mission file not found: $MISSION" >&2
  exit 1
fi

echo "Hanna: launching mission -> $MISSION"
echo

PROMPT="Read AGENTS.md first. Then read $MISSION and execute that mission completely. Treat the mission file as the authoritative scope. Inspect the current repository and tests before editing. Do not begin later milestones. Run every validation required by the mission. Commit completed work with a concise milestone message and leave the working tree clean. Do not push; the Hanna wrapper will push only after verifying a clean successful run. At the end, report what changed, what tests passed, and any design pressure discovered."

CODEX_ARGS=(
  exec
  -c 'sandbox_mode="workspace-write"'
  -c 'approval_policy="never"'
)

if [[ -n "${HANNA_MODEL:-}" ]]; then
  CODEX_ARGS+=(--model "$HANNA_MODEL")
  echo "Hanna: model override -> $HANNA_MODEL"
else
  echo "Hanna: model -> Codex configured default"
fi

echo "Hanna: autonomy -> workspace-write, approval_policy=never"
codex "${CODEX_ARGS[@]}" "$PROMPT"

echo
echo "Hanna: Codex finished. Verifying repository state..."

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Hanna: Codex returned with a dirty working tree. Refusing to push." >&2
  git status --short >&2
  exit 1
fi

END_HEAD="$(git rev-parse HEAD)"
if [[ "$END_HEAD" == "$START_HEAD" ]]; then
  echo "Hanna: no new commit was created; nothing to push."
else
  echo "Hanna: pushing completed mission to origin/$BRANCH..."
  git push origin "$BRANCH"
  echo "Hanna: push complete."
fi

echo
echo "Hanna: final repository status:"
git status -sb
git log -1 --oneline
